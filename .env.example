# ── Payment method ─────────────────────────────────────────────────────────
# Residents pay over the society's own UPI QR (no third-party gateway, no
# commission). Put the society's UPI id in Admin → Settings, in the app itself.
# There are no gateway keys to configure.

# ── Firebase ────────────────────────────────────────────────────────────────
# Paste the web-app config from Firebase console → Project settings → Your apps.
# Leave ALL of these empty to run the app in Demo mode (data lives in the
# browser's localStorage — every feature still works, great for trying it out).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Email (optional fallback, besides the Firebase "mail" collection) ──────
# Admin e-mail that receives the low-storage warning. Default shown.
VITE_ADMIN_EMAIL=
