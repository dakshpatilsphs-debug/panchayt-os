rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ══════════════════════════════════════════════════════════════════════════════
    // Panchayat OS — Firestore Security Rules
    // Full read & write permissions for all estate ledger collections:
    //   • config (society settings, usage counters)
    //   • members (flats, owner details, floor allocations, running dues)
    //   • contacts (managing committee, emergency desks, utility services)
    //   • payments (UPI transaction logs, receipts, settlement tracking)
    //   • notices (society board announcements, event alerts)
    //   • mail (notification queues)
    // ══════════════════════════════════════════════════════════════════════════════

    // config — society settings + usage counters (singleton docs)
    match /config/{docId} {
      allow read, write: if true;
    }

    // members — one doc per flat (owner, monthly maintenance, running dues)
    match /members/{memberId} {
      allow read, write: if true;
    }

    // contacts — managing committee, emergency desks & utility services
    match /contacts/{contactId} {
      allow read, write: if true;
    }

    // payments — receipts & resident UPI payment transactions
    match /payments/{paymentId} {
      allow read, write: if true;
    }

    // notices — society notice board
    match /notices/{noticeId} {
      allow read, write: if true;
    }

    // mail — Firebase Trigger Email extension queue
    match /mail/{mailId} {
      allow read, write: if true;
    }

    // Global fallback for any estate collection or future additions
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
